[Unit]
Description=Back up the Jingfa Smart Match MySQL database
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/jingfa-smart-match/database/backup.sh

[Service]
Type=oneshot
ExecStart=/opt/jingfa-smart-match/database/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
